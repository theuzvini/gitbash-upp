<div>
    <h1>Formulário 2.0 - Cadastro</h1>
    <form action="/views/layouts/dashboard.handlebars" method="post" class="form">
        <div>
            <label for="nome">Insira seu Nome</label>
                <input type="text" name="nome" placeholder="Elon Musk..">
            <label for="email">Insira seu Email</label>
                <input type="text" name="email" placeholder="junincapacap@gmail..">
            <label for="senha">Insira sua Senha</label>
                <input type="password" name="senha" placeholder="40028922..">
            <label for="cpf">Insira seu CPF</label>
                <input type="text" name="cpf" placeholder="000.000.000.00..">
            <label for="data">Insira sua Data</label>
                <input type="date" name="data" placeholder="01/01/01">
            <button type="submit">Enviar</button>
        </div>
    </form>
</div>
